APP_NAME="Royal LeadMagnet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lvh.me:8000

# Sous-domaines commerciaux en local via lvh.me (DNS wildcard → 127.0.0.1)
# Ex: http://comtest01.lvh.me:8000/f/mon-tunnel
APP_SUBDOMAIN_BASE=lvh.me

# Non utilisé en local
APP_SERVER_IP=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royal_leadmagnet
DB_USERNAME=root
DB_PASSWORD=ton_mot_de_passe_mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Laisser vide en local pour que les sessions fonctionnent sur lvh.me et ngrok
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email en local : utiliser Mailpit (http://localhost:8025) ou Mailtrap
# Mailpit : npm install -g mailpit  →  mailpit
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@royal-leadmagnet.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Clés VAPID pour les notifications push PWA
# Générer avec : php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@royal-leadmagnet.local
